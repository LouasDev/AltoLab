<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <connectionStrings>
        <!-- Banco SQLite: arquivo criado automaticamente na pasta do executavel na primeira execucao -->
        <!-- O caminho relativo "AltoLabDB.db" e resolvido em relacao a Application.StartupPath -->
        <add name="AltoLabConnection"
             connectionString="Data Source=AltoLabDB.db;Version=3;"
             providerName="System.Data.SQLite" />
    </connectionStrings>
    <startup>
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
    </startup>
</configuration>
